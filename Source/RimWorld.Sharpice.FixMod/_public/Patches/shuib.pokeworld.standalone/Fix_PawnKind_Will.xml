<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>宝可梦世界·新的旅途</li>
		</mods>
		<match Class="PatchOperationConditional">
			<xpath>Defs/PawnKindDef[defName="PWS_RocketGrunt"]/initialWillRange</xpath>
			<nomatch Class="PatchOperationAdd">
				<xpath>Defs/PawnKindDef[defName="PWS_RocketGrunt"]</xpath>
				<value>
					<initialWillRange>1~3</initialWillRange>
				</value>
			</nomatch>
		</match>
	</Operation>
</Patch>
