<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<DebugType>embedded</DebugType>
		<TargetFramework>net10.0</TargetFramework>
		<OutputPath>$(OutputPath)Assemblies/</OutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Lib.Harmony" PrivateAssets="all" />
		<PackageReference Include="Krafs.Rimworld.Ref" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="_public/**/*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>../$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)/_public', '%(FullPath)'))</Link>
		</Content>
	</ItemGroup>
</Project>
